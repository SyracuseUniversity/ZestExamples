// Run every process as a Slurm job.  Nextflow writes a batch script for each
// process, calls sbatch, and polls squeue until it finishes.
process {
    executor = 'slurm'
    queue    = 'compute_zone2,normal'   // Slurm partition(s)
    cpus     = 1
    memory   = '1 GB'
    time     = '10m'
    // Anything else you would put on an #SBATCH line goes here, for example
    // clusterOptions = '--gres=gpu:1'
}

executor {
    queueSize       = 20     // at most this many jobs in the queue at once
    pollInterval    = '15 sec'
    submitRateLimit = '10/1min'
}
